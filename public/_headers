# SW と manifest は常に最新を渡す。キャッシュされると更新が届かなくなる。
/sw.js
  Cache-Control: no-cache

/manifest.webmanifest
  Cache-Control: no-cache

# Worker を通らずに配信される SPA の資産にだけ効く。/api/* のヘッダは src/api/app.ts で付ける。
# メール本文の srcdoc iframe はこの CSP を継承する。img-src から https: を外すと
# 「画像を表示」が効かなくなる。既定のブロックは MessageHtml が差し込む meta CSP が担う。
#
# challenges.cloudflare.com は Turnstile（ログインのボット確認）。script-src と frame-src の
# 両方が要る（ウィジェットは iframe で描かれる）。メール本文側は MessageHtml が
# `default-src 'none'` の meta CSP を差し込み、複数の CSP は積集合で効くので、
# ここを緩めても本文で外部スクリプトや iframe が動くようにはならない。
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self' https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: no-referrer
  Strict-Transport-Security: max-age=15552000
