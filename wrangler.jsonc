{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "tsubame",
	"main": "./src/worker.ts",
	"compatibility_date": "2026-08-22",
	"compatibility_flags": ["nodejs_compat"],
	"workers_dev": false,
	"keep_vars": true,
	"observability": { "enabled": true },
	"upload_source_maps": true,

	"assets": {
		"binding": "ASSETS",
		"directory": "./dist/client",
		"not_found_handling": "single-page-application"
	},

	"vars": {
		"APP_NAME": "tsubame",
		"EMAIL_WORKER_NAME": "tsubame"
	},

	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "tsubame",
			// database_id はデプロイ時に注入する。アカウント固有 ID はコミットしない。
			"database_id": "00000000-0000-0000-0000-000000000000",
			"migrations_dir": "migrations"
		}
	],

	"r2_buckets": [{ "binding": "BUCKET", "bucket_name": "tsubame-mail" }],

	"queues": {
		"producers": [
			{ "binding": "INBOUND_QUEUE", "queue": "tsubame-inbound" },
			{ "binding": "OUTBOUND_QUEUE", "queue": "tsubame-outbound" }
		],
		"consumers": [
			{ "queue": "tsubame-inbound", "max_batch_size": 5, "max_retries": 3 },
			{ "queue": "tsubame-outbound", "max_batch_size": 5, "max_retries": 3 }
		]
	},

	"send_email": [{ "name": "EMAIL", "remote": true }],

	"ratelimits": [
		{ "name": "LOGIN_RATE_LIMIT", "namespace_id": "1001", "simple": { "limit": 20, "period": 60 } }
	]
}
