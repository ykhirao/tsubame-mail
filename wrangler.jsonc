{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "tsubame",
	"main": "./src/worker.ts",
	"compatibility_date": "2026-08-22",
	"compatibility_flags": ["nodejs_compat"],
	"workers_dev": false,
	"keep_vars": true,
	"observability": { "enabled": true },
	"upload_source_maps": true,

	"assets": {
		"binding": "ASSETS",
		"directory": "./dist/client",
		"not_found_handling": "single-page-application",
		// 無いと、添付のダウンロードリンクのようなナビゲーションは Worker を通らず
		// index.html が返る（SPA モードの既定動作）。
		"run_worker_first": ["/api/*"]
	},

	"vars": {
		"APP_NAME": "tsubame",
		"EMAIL_WORKER_NAME": "tsubame"
	},

	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "tsubame",
			// database_id はデプロイ時に注入する。アカウント固有 ID はコミットしない。
			"database_id": "00000000-0000-0000-0000-000000000000",
			"migrations_dir": "migrations"
		}
	],

	"r2_buckets": [{ "binding": "BUCKET", "bucket_name": "tsubame-mail" }],

	"queues": {
		"producers": [
			{ "binding": "INBOUND_QUEUE", "queue": "tsubame-inbound" },
			{ "binding": "OUTBOUND_QUEUE", "queue": "tsubame-outbound" }
		],
		"consumers": [
			{
				"queue": "tsubame-inbound",
				"max_batch_size": 5,
				"max_retries": 3,
				"dead_letter_queue": "tsubame-inbound-dlq"
			},
			{ "queue": "tsubame-outbound", "max_batch_size": 5, "max_retries": 3, "dead_letter_queue": "tsubame-outbound-dlq" }
		]
	},

	// おやすみ明けのまとめ通知は 24 時間を超えうるので、キューの遅延送信では届かない。
	"triggers": { "crons": ["*/5 * * * *"] },

	"send_email": [{ "name": "EMAIL", "remote": true }],

	"ratelimits": [
		{ "name": "LOGIN_RATE_LIMIT", "namespace_id": "1001", "simple": { "limit": 20, "period": 60 } },
		{ "name": "SEND_RATE_LIMIT", "namespace_id": "1002", "simple": { "limit": 100, "period": 60 } }
	],

	// ステージング（tsubame-stg.forte.llc）。wrangler は env の vars もバインディングも
	// 継承しないので、本番と同じものを全部書き直す。名前を 1 つでも本番と共有すると、
	// ステージングの操作が本番のデータに届く。
	//
	// **受信は test.hirao.cc だけに割り当てる。** catch-all はゾーン単位なので、
	// 本番と同じ forte.llc で受けるとルールが混在する（requirements.md §5）。
	// 送信も本番ドメインを使わない（constraints.md §2「送信」の評判の話）。
	"env": {
		"staging": {
			"name": "tsubame-staging",
			"workers_dev": false,
			"keep_vars": true,
			"observability": { "enabled": true },
			"upload_source_maps": true,

			"assets": {
				"binding": "ASSETS",
				"directory": "./dist/client",
				"not_found_handling": "single-page-application",
				"run_worker_first": ["/api/*"]
			},

			// EMAIL_WORKER_NAME は name と一致させる。ずれると受信が止まり、
			// 未設定だと provision.ts の DEFAULT_WORKER_NAME（"tsubame"）に落ちて
			// **本番 Worker 宛のルールを作ってしまう**。tests/worker-name.test.ts が見張る。
			// APP_NAME は /api/health に出るので、どちらの環境を見ているか判別できるようにする。
			"vars": {
				"APP_NAME": "tsubame-staging",
				"EMAIL_WORKER_NAME": "tsubame-staging"
			},

			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "tsubame-staging",
					// 本番とは別のプレースホルダにする。同じ文字列だと deploy.sh の
					// 置換が両方に当たり、ステージングのデプロイで本番の DB を向く。
					"database_id": "11111111-1111-1111-1111-111111111111",
					"migrations_dir": "migrations"
				}
			],

			"r2_buckets": [{ "binding": "BUCKET", "bucket_name": "tsubame-staging-mail" }],

			"queues": {
				"producers": [
					{ "binding": "INBOUND_QUEUE", "queue": "tsubame-staging-inbound" },
					{ "binding": "OUTBOUND_QUEUE", "queue": "tsubame-staging-outbound" }
				],
				"consumers": [
					{
						"queue": "tsubame-staging-inbound",
						"max_batch_size": 5,
						"max_retries": 3,
						"dead_letter_queue": "tsubame-staging-inbound-dlq"
					},
					{
						"queue": "tsubame-staging-outbound",
						"max_batch_size": 5,
						"max_retries": 3,
						"dead_letter_queue": "tsubame-staging-outbound-dlq"
					}
				]
			},

			"triggers": { "crons": ["*/5 * * * *"] },

			"send_email": [{ "name": "EMAIL", "remote": true }],

			"ratelimits": [
				{ "name": "LOGIN_RATE_LIMIT", "namespace_id": "1001", "simple": { "limit": 20, "period": 60 } },
				{ "name": "SEND_RATE_LIMIT", "namespace_id": "1002", "simple": { "limit": 100, "period": 60 } }
			]
		}
	}
}
