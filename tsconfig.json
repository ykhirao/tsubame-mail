{
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"module": "ESNext",
		"moduleResolution": "bundler",
		"jsx": "react-jsx",
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"noEmit": true,
		"skipLibCheck": true,
		"esModuleInterop": true,
		"resolveJsonModule": true,
		"isolatedModules": true,
		"verbatimModuleSyntax": true,
		"types": ["@cloudflare/workers-types", "vite/client", "@cloudflare/vitest-pool-workers/types"],
		"paths": { "@/*": ["./src/*"] }
	},
	"include": ["src", "tests", "*.ts", "worker-env.d.ts"]
}
